# ============================================================
# Legito Agent Backend - Environment Variables
# ============================================================

# Server
PORT=3001
NODE_ENV=production

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/legito_agent
# Or individual fields:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=legito_agent
# DB_USER=user
# DB_PASSWORD=password

# Azure AD / Entra ID (Authentication)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_ISSUER=https://login.microsoftonline.com/{tenant-id}/v2.0

# Azure OpenAI (replaces Lovable AI Gateway)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Browser-Use Cloud API
BROWSER_USE_API_KEY=your-browser-use-api-key

# CORS
CORS_ORIGIN=https://your-frontend-url.azurewebsites.net

# Self-invoke URL (for batch test scheduling)
SELF_URL=https://your-backend-url.azurewebsites.net
